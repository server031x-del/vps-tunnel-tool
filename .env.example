# Generate with: openssl rand -hex 32
VPS_TUNNEL_TOOL_SECRET=replace-with-a-long-random-value

# Application login shown after the reverse-proxy authentication layer.
VPS_TUNNEL_TOOL_APP_USER=change-me
VPS_TUNNEL_TOOL_APP_PASSWORD=replace-with-a-strong-password

# Comma-separated domains offered by the URL assignment wizard.
VPS_TUNNEL_TOOL_PUBLIC_DOMAINS=example.com
