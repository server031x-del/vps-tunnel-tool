[Unit]
Description=VPS Tunnel Tool Web UI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vps-tunnel-tool
EnvironmentFile=/etc/vps-tunnel-tool.env
ExecStart=/opt/vps-tunnel-tool/.venv/bin/python /opt/vps-tunnel-tool/main.py runserver --host 127.0.0.1 --port 5000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
